<script>
/* ---------- LAYER CARDS ---------- */
document.querySelectorAll('.layer-card').forEach(card=>{
  card.addEventListener('click',()=>{
    document.querySelectorAll('.layer-card').forEach(c=>c!==card && c.classList.remove('active'));
    card.classList.toggle('active');
  });
});

/* ---------- FARMER DATA ---------- */
const FARMERS = [
  {
    id:'grace', name:'Grace Banda', district:'Kasungu', crop:'Maize', area:'2.1 ha',
    gps:'-13.038, 33.481', moisture:'34%', organic:'2.8%', ph:'6.1',
    seasons:5, score:742, tier:'Tier A — Prime',
    hist:[1.6,1.8,1.7,2.0,2.1], predicted:2.4,
    ndviSeed:11, hash:'0x8f4a1c2e9b7d3f6081a2c9e4b5d7f1032c8a9e6d'
  },
  {
    id:'enock', name:'Enock Phiri', district:'Mzimba', crop:'Soybean', area:'1.4 ha',
    gps:'-11.899, 33.603', moisture:'26%', organic:'2.1%', ph:'5.7',
    seasons:3, score:615, tier:'Tier B — Developing',
    hist:[1.1,1.0,1.3,1.4,1.4], predicted:1.6,
    ndviSeed:37, hash:'0x3b7e9a1d5c2f8064b1e7a3c9d2f6081a5c3e9b74'
  },
  {
    id:'mercy', name:'Mercy Nkhoma', district:'Rumphi', crop:'Groundnuts / Tobacco', area:'3.0 ha',
    gps:'-11.020, 33.860', moisture:'41%', organic:'3.4%', ph:'6.4',
    seasons:6, score:810, tier:'Tier A+ — Preferred',
    hist:[2.0,2.2,2.3,2.5,2.7], predicted:3.0,
    ndviSeed:59, hash:'0x1a9c4e7b2d6f803c9a1e5b7d2f4082e6c9b1a3d5'
  }
];

let current = FARMERS[0];
let yieldChart, loanAmount = 0, predictedYield = 0;

/* ---------- FARMER TABS ---------- */
const tabsEl = document.getElementById('farmerTabs');
FARMERS.forEach((f,i)=>{
  const btn = document.createElement('button');
  btn.className = 'farmer-tab' + (i===0?' active':'');
  btn.textContent = `${f.name} · ${f.district}`;
  btn.addEventListener('click',()=>{
    document.querySelectorAll('.farmer-tab').forEach(t=>t.classList.remove('active'));
    btn.classList.add('active');
    current = f;
    renderFarmer();
    resetContract();
  });
  tabsEl.appendChild(btn);
});

/* ---------- RENDER FARMER ---------- */
function renderFarmer(){
  document.getElementById('mMoisture').textContent = current.moisture;
  document.getElementById('mOrganic').textContent = current.organic;
  document.getElementById('mPh').textContent = current.ph;
  document.getElementById('mArea').textContent = current.area;

  document.getElementById('sbtName').textContent = current.name;
  document.getElementById('sbtDistrict').textContent = current.district;
  document.getElementById('sbtCrop').textContent = current.crop;
  document.getElementById('sbtGps').textContent = current.gps;
  document.getElementById('sbtSeasons').textContent = current.seasons;
  document.getElementById('sbtToken').textContent = 'DTF-' + String(current.score).padStart(6,'0').slice(0,6);
  document.getElementById('sbtScore').textContent = Math.round(current.score/10) + '%';
  document.getElementById('sbtScoreBar').style.width = Math.round(current.score/10) + '%';

  predictedYield = current.predicted;

  const labels = ['2022','2023','2024','2025','2026'];
  const actual = current.hist.slice(0,5);
  const predicted = [null,null,null,null,current.predicted];

  if(yieldChart) yieldChart.destroy();
  const ctx = document.getElementById('yieldChart').getContext('2d');
  yieldChart = new Chart(ctx,{
    type:'line',
    data:{
      labels,
      datasets:[
        {label:'Actual Yield (t/ha)',data:actual,borderColor:'#A8481C',backgroundColor:'rgba(168,72,28,.08)',tension:.35,fill:true,pointRadius:4,pointBackgroundColor:'#A8481C'},
        {label:'AI Predicted (t/ha)',data:predicted,borderColor:'#1F9E8C',borderDash:[6,4],tension:.35,pointRadius:4,pointBackgroundColor:'#1F9E8C'}
      ]
    },
    options:{
      responsive:true,maintainAspectRatio:false,
      plugins:{legend:{position:'bottom',labels:{boxWidth:10,font:{size:11}}}},
      scales:{y:{grid:{color:'rgba(32,25,15,.06)'},title:{display:true,text:'t/ha'}},x:{grid:{display:false}}}
    }
  });
}

/* ---------- SMART CONTRACT ---------- */
const feed = document.getElementById('ledgerFeed');
const btnRequest = document.getElementById('stepRequest');
const btnDisburse = document.getElementById('stepDisburse');
const btnHarvest = document.getElementById('stepHarvest');
const btnReset = document.getElementById('stepReset');

function log(html){
  const line = document.createElement('div');
  line.className = 'ln';
  line.innerHTML = html;
  feed.appendChild(line);
  feed.scrollTop = feed.scrollHeight;
}
function fakeHash(){
  return '0x'+Array.from({length:12}).map(()=>Math.floor(Math.random()*16).toString(16)).join('');
}
function resetContract(){
  feed.innerHTML = '';
  btnRequest.disabled = false;
  btnDisburse.disabled = true;
  btnHarvest.disabled = true;
  btnReset.disabled = true;
  log('<span class="tag">[ledger]</span> awaiting contract initiation for '+current.name+'…');
}

btnRequest.addEventListener('click',()=>{
  const pricePerTon = 420000;
  loanAmount = Math.round(predictedYield * pricePerTon * 0.45 / 1000)*1000;
  log(`<span class="tag">[twin]</span> yield forecast confirmed: <b>${predictedYield} t/ha</b> for ${current.name}`);
  log(`<span class="tag">[contract]</span> financing request created — hash ${fakeHash()}`);
  log(`<span class="tag">[terms]</span> input loan offered: <span class="amt">MWK ${loanAmount.toLocaleString()}</span> against forecast yield`);
  btnRequest.disabled = true;
  btnDisburse.disabled = false;
  btnReset.disabled = false;
});

btnDisburse.addEventListener('click',()=>{
  log(`<span class="tag">[agro-processor]</span> inputs disbursed to farmer — seed &amp; fertilizer released`);
  log(`<span class="tag">[chain]</span> disbursement recorded on SBT — tx ${fakeHash()}`);
  log(`<span class="tag">[status]</span> season in progress — twin will continue monitoring NDVI trend`);
  btnDisburse.disabled = true;
  btnHarvest.disabled = false;
});

btnHarvest.addEventListener('click',()=>{
  const totalRevenue = Math.round(predictedYield * 420000);
  const repay = Math.min(loanAmount*1.08, totalRevenue*0.6);
  const surplus = Math.max(totalRevenue - repay, totalRevenue*0.2);
  log(`<span class="tag">[harvest]</span> yield delivered — settlement triggered automatically`);
  log(`<span class="tag">[contract]</span> repayment routed to agro-processor: <span class="amt">MWK ${Math.round(repay).toLocaleString()}</span>`);
  log(`<span class="tag">[mobile money]</span> surplus sent to farmer wallet: <span class="amt">MWK ${Math.round(surplus).toLocaleString()}</span>`);
  log(`<span class="tag">[chain]</span> credit score updated on SBT — repayment on time, +score`);
  btnHarvest.disabled = true;
});

btnReset.addEventListener('click', resetContract);

/* ---------- INIT ---------- */
renderFarmer();
resetContract();
</script>
